{
    "name": "joomla/com_boilerplate",
    "description": "Joomla component boilerplate with PSR-12 coding standards",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "rector/rector": "^2.0",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "scripts": {
        "php:lint": "src/administrator/components/com_boilerplate/vendor/bin/phpcs -p -s src",
        "php:lint:errors": "src/administrator/components/com_boilerplate/vendor/bin/phpcs -p -s --runtime-set ignore_warnings_on_exit 1 src",
        "php:lint:autofix": "src/administrator/components/com_boilerplate/vendor/bin/phpcbf src",
        "php:rector": "src/administrator/components/com_boilerplate/vendor/bin/rector process --dry-run",
        "php:rector:fix": "src/administrator/components/com_boilerplate/vendor/bin/rector process",
        "php:rector:clear-cache": "src/administrator/components/com_boilerplate/vendor/bin/rector clear-cache",
        "php:rector:fix:lint": [
            "@php:rector:fix",
            "src/administrator/components/com_boilerplate/vendor/bin/phpcbf src || true",
            "@php:lint"
        ]
    },
    "config": {
        "vendor-dir": "src/administrator/components/com_boilerplate/vendor",
        "platform": {
            "php": "8.3"
        },
        "sort-packages": true
    }
}
