{
    "name": "joomla/com_boilerplate",
    "description": "Joomla component boilerplate with PSR-12 coding standards",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.10"
    },
    "scripts": {
        "php:lint": "phpcs -p -s",
        "php:lint:errors": "phpcs -p -s --runtime-set ignore_warnings_on_exit 1",
        "php:lint:autofix": "phpcbf"
    },
    "config": {
        "vendor-dir": "src/administrator/components/com_boilerplate/vendor",
        "platform": {
            "php": "8.3"
        },
        "sort-packages": true
    }
}
